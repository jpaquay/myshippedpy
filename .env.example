##############################################################################
# BAROGROOVE -- environment reference
# "your sky has a soundtrack"
#
# Copy to `.env` and fill in what you need. Every setting is prefixed `BG_`
# (pydantic-settings env_prefix) and every one of them is OPTIONAL.
#
#   THE APP BOOTS WITH AN ENTIRELY EMPTY ENVIRONMENT.
#
# That is a design commitment, not an accident. `cp /dev/null .env && uvicorn
# app.main:app` gives you a working local Barogroove: in-memory almanac,
# in-memory token vault, dev auth, and whatever upstream data is available
# without a key. Each setting below says what turns on when you provide it and
# what happens when you do not.
#
# ---------------------------------------------------------------------------
# NO REAL VALUES IN THIS FILE. EVER.
#
# `.env.example` is committed. `.env` is not (check .gitignore). Anything
# genuinely secret belongs in Secret Manager and is referenced here as
# `sm://<secret-id>`, which `config.resolve_secret()` resolves at startup and
# which returns "" on failure rather than crashing.
#
# Two reference forms are accepted:
#   sm://barogroove-lastfm-api-key
#   projects/my-project/secrets/barogroove-lastfm-api-key/versions/latest
#
# The short form is resolved against BG_GCP_PROJECT. Prefer it.
# ---------------------------------------------------------------------------
##############################################################################


##############################################################################
# CORE
##############################################################################

# Which world are we in: local | dev | prod
# Absent -> "local". This is the master switch for every dangerous
# convenience in the codebase. See BG_AUTH_ALLOW_INSECURE_DEV_TOKENS and the
# token vault's INSECURE-DEV path, both of which are gated on this being
# exactly "local".
BG_ENVIRONMENT=local

# The public origin. Used for OAuth redirect URIs, CORS, and absolute links in
# generated content.
# Absent -> "bg.netdev.be". Set it to http://localhost:8080 when developing
# against the Spotify OAuth flow, or the redirect will bounce to production.
BG_PUBLIC_HOST=bg.netdev.be


##############################################################################
# GOOGLE CLOUD
##############################################################################

# GCP project id. The single most consequential setting here: it is what
# `settings.has_firestore` keys off.
# Absent -> no Firestore, no Secret Manager. The container falls back to
# MemoryAlmanac and MemoryTokenVault, everything works, nothing survives a
# restart. This is the correct local default.
BG_GCP_PROJECT=

# Region. europe-west1. Not a suggestion.
# Absent -> "europe-west1". Do not set this to anything else. Cloud Run,
# Artifact Registry, Cloud Build, Secret Manager replication and the Firestore
# database all live there, and a mismatch produces cross-region latency plus a
# data-residency problem nobody wants to explain.
BG_GCP_REGION=europe-west1

# Resolve sm:// references through Secret Manager.
# Absent -> false. When false, an `sm://...` value is left as the literal
# string, which will fail validation wherever a real key is expected -- loudly,
# which is what you want. Set true in dev and prod; leave false locally unless
# you have ADC configured and want to test the resolution path.
BG_USE_SECRET_MANAGER=false


##############################################################################
# FIREBASE
##############################################################################

# Firebase project id. Usually identical to BG_GCP_PROJECT.
# Absent -> falls back to BG_GCP_PROJECT. If BOTH are empty, ID-token
# verification refuses every request with a 503: without a project id there is
# no audience to check, and a token with an unchecked audience is a token from
# any Firebase project on earth.
BG_FIREBASE_PROJECT_ID=

# Firebase Web API key, handed to the Flutter client for sign-in.
# Not actually a secret -- it ships in the JS bundle and is restricted by
# authorised-domain configuration, not by obscurity. Stored in Secret Manager
# anyway so that config lives in exactly one place.
# Absent -> the client-config endpoint returns null and the frontend falls back
# to its own compile-time firebase config.
BG_FIREBASE_WEB_API_KEY=sm://barogroove-firebase-web-api-key

# Named Firestore database. "(default)" unless you deliberately created
# another one.
# Absent -> "(default)". Note the parentheses are part of the literal name.
BG_FIRESTORE_DATABASE=(default)


##############################################################################
# AUTH
##############################################################################

# Accept `Authorization: Bearer dev:<uid>` and synthesise a user.
# Absent -> true (the config default), BUT it is inert unless BG_ENVIRONMENT is
# exactly "local". Both conditions are required, checked in one place
# (`auth.dev_tokens_enabled`), and there is a test asserting that flipping
# either one shuts the door.
#
# Every acceptance logs a WARNING naming the uid. If you see that line in a
# deployed environment's logs, something is very wrong and you should treat it
# as an incident.
#
# cloudrun.yaml sets this to "false" explicitly even though prod already
# ignores it. Two locks on the same door.
BG_AUTH_ALLOW_INSECURE_DEV_TOKENS=true

# Fernet key for encrypting provider tokens (Spotify refresh tokens, Last.fm
# session keys) at rest in Firestore. 32 url-safe base64-encoded bytes.
#
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Absent in local  -> the token vault still works but stores payloads under an
#                     `INSECURE-DEV-PLAINTEXT` marker and warns loudly on every
#                     read and write. It does not pretend the data is
#                     encrypted, and those envelopes are refused outright if
#                     they ever surface in a non-local environment.
# Absent elsewhere -> ConfigurationError at first use. Refusing to start beats
#                     storing credentials in the clear.
#
# Rotating this invalidates every stored provider token; users re-pair. See
# deploy/service-account.md.
BG_TOKEN_ENCRYPTION_KEY=sm://barogroove-token-encryption-key


##############################################################################
# MUSIC PROVIDERS
# (owned by the Spotify / Last.fm workers -- listed here because the deploy
#  path provisions the secrets and the vault stores the resulting tokens)
##############################################################################

# Spotify app credentials, from developer.spotify.com/dashboard.
# Redirect URI must be registered there as:
#   https://${BG_PUBLIC_HOST}/api/pair/spotify/callback
# Absent -> Spotify pairing is unavailable. The forge still produces a playlist
# from the catalogue it has; it just cannot push it to your account, and the
# degradation ledger notes "spotify: not configured".
BG_SPOTIFY_CLIENT_ID=sm://barogroove-spotify-client-id
BG_SPOTIFY_CLIENT_SECRET=sm://barogroove-spotify-client-secret

# Last.fm API key and shared secret, from last.fm/api/account/create. Used for
# tag and similar-artist enrichment and for signed user OAuth session exchange.
# Absent -> genre-corridor scoring falls back to the built-in taxonomy.
# Recommendations get blunter; nothing breaks.
BG_LASTFM_API_KEY=sm://barogroove-lastfm-api-key
BG_LASTFM_API_SECRET=sm://barogroove-lastfm-api-secret


##############################################################################
# OBSERVABILITY
##############################################################################

# Root log level: DEBUG | INFO | WARNING | ERROR
# Absent -> INFO. DEBUG is loud; the Firestore retry path in particular logs
# every backoff.
BG_LOG_LEVEL=INFO

# Emit JSON logs instead of human-readable ones.
# Absent -> false locally, and cloudrun.yaml does not set it either -- Cloud
# Logging parses plain stdout perfectly well. Set true if you want structured
# fields you can query on.
BG_LOG_JSON=false


##############################################################################
# LOCAL DEVELOPMENT AGAINST THE EMULATOR SUITE
#
# `firebase emulators:start` from firebase_cfg/ brings up auth on 9099 and
# firestore on 8080. The google-cloud libraries pick these up from the
# well-known env vars below -- note they are NOT BG_-prefixed, because they
# are read by Google's client libraries, not by our Settings model.
#
# Leave them commented out unless the emulator is actually running: the client
# libraries will happily connect to a dead port and hang.
##############################################################################

# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GOOGLE_CLOUD_PROJECT=barogroove-dev


##############################################################################
# WHAT AN EMPTY .env ACTUALLY GIVES YOU
#
#   environment            local
#   auth                   dev tokens accepted -- `Authorization: Bearer dev:me`
#   almanac                MemoryAlmanac, forgotten on restart
#   token vault            MemoryTokenVault, unencrypted, loudly warned about
#   firestore              not used
#   secret manager         not used; sm:// strings pass through unresolved
#   spotify / last.fm      unavailable, noted in the degradation ledger
#   forge                  works
#
# Which is the point. You should be able to clone this repo, run it, and hear
# your sky, before you have a Google Cloud project.
##############################################################################
